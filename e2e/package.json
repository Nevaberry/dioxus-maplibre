{
  "name": "dioxus-maplibre-e2e",
  "private": true,
  "type": "commonjs",
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "serve": "^14.2.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:update-snapshots": "playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "serve:showcase": "serve --single --listen tcp://127.0.0.1:8080 --no-port-switching --no-request-logging --no-clipboard ../examples/showcase-web/dist/public"
  }
}
