{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true
  },
  "include": [
    "playwright.config.ts",
    "playwright.mobile.config.ts",
    "tests/**/*.ts",
    "mobile-tests/**/*.ts"
  ]
}
